# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# Android build output
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/
android/local.properties
android/captures/

# Signing: only the template's debug keystore is tracked
*.keystore
*.jks
!android/app/debug.keystore

# Environment
.env
.env.*
!.env.example
