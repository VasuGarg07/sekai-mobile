{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [],
    "paths": {
      "@/assets/*": ["./assets/*"],
      "@/*": ["./src/*"],
      "@firebase/auth": ["./node_modules/@firebase/auth/dist/index.rn.d.ts"]
    }
  },
  "include": ["index.js", "src/**/*", "*.d.ts"],
  "exclude": ["node_modules", "android"]
}
